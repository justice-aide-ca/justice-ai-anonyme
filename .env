const OpenAI = require('openai');

// Initialiser OpenAI
const openai = new OpenAI({
    apiKey: process.env.OPENAI_API_KEY
});

// Route pour les demandes anonymes avec réponse IA
app.post('/api/submit-anonymous-case', async (req, res) => {
    const { country, caseType, description, anonymousId } = req.body;
    
    console.log('\n🕵️ Nouvelle demande anonyme reçue');
    console.log(`🌍 Pays: ${country}`);
    console.log(`⚖️ Type: ${caseType}`);
    console.log(`📝 Description: ${description.substring(0, 100)}...`);
    
    // Générer une référence unique
    const reference = 'REF_' + Date.now().toString(36).toUpperCase();
    
    // Préparer le prompt pour l'IA
    const prompt = `
Tu es un conseiller juridique professionnel, bienveillant et précis. Voici une demande d'aide juridique :

PAYS: ${country}
TYPE DE SITUATION: ${caseType}
DESCRIPTION: ${description}

Réponds avec les sections suivantes :
1. 📋 RÉSUMÉ DE LA SITUATION (2-3 lignes)
2. ⚖️ CONSEILS JURIDIQUES (recommandations pratiques)
3. 📌 PROCHAINES ÉTAPES (actions concrètes à entreprendre)
4. ⚠️ AVERTISSEMENT (rappel que ceci n'est pas un conseil juridique officiel)

Sois clair, empathique et utile. Utilise des émojis pour une meilleure lisibilité.
    `;
    
    let aiResponse = null;
    let aiError = null;
    
    try {
        // Appeler l'API OpenAI
        const completion = await openai.chat.completions.create({
            model: "gpt-3.5-turbo",
            messages: [
                { role: "system", content: "Tu es un conseiller juridique professionnel et empathique." },
                { role: "user", content: prompt }
            ],
            temperature: 0.7,
            max_tokens: 1000
        });
        
        aiResponse = completion.choices[0].message.content;
        console.log('✅ Réponse IA générée');
        
    } catch (error) {
        console.error('❌ Erreur IA:', error.message);
        aiError = error.message;
        aiResponse = "⚠️ Désolé, le service de conseil IA est temporairement indisponible. Un conseiller humain vous répondra sous 24h.";
    }
    
    // Sauvegarder la demande (ajoutons un fichier pour stocker)
    const fs = require('fs');
    const demande = {
        reference,
        date: new Date().toISOString(),
        country,
        caseType,
        description,
        aiResponse,
        status: 'traité'
    };
    
    // Lire les demandes existantes
    let demandes = [];
    try {
        const data = fs.readFileSync('./data/demandes.json', 'utf8');
        demandes = JSON.parse(data);
    } catch (err) {
        demandes = [];
    }
    
    // Ajouter la nouvelle demande
    demandes.push(demande);
    fs.writeFileSync('./data/demandes.json', JSON.stringify(demandes, null, 2));
    
    res.json({
        success: true,
        message: 'Votre demande anonyme a bien été reçue',
        reference: reference,
        aiResponse: aiResponse,
        date: new Date().toISOString()
    });
});